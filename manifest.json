{
  "manifest_version": 3,
  "name": "Instagram Better URLs",
  "version": "1.1.0",
  "icons": {
    "128": "icon.svg"
  },
  "description": "Always include user id in post URLs on Instagram.",
  "content_scripts": [
    {
      "matches": [
        "https://instagram.com/*",
        "https://www.instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "@instagram-better-urls",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}

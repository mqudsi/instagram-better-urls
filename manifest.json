{
  "manifest_version": 3,
  "name": "Instagram Better URLs",
  "version": "1.1.1",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "description": "Always include user id in post URLs on Instagram.",
  "content_scripts": [
    {
      "matches": [
        "https://instagram.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Instagram Better URLs"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@instagram-better-urls",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
